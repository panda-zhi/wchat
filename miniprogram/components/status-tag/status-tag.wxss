.status-tag {
  font-size: 24rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.status-tag--warn {
  color: #d46b08;
  background: #fff4e6;
}

.status-tag--primary {
  color: var(--color-primary);
  background: #fff3ed;
}

.status-tag--success {
  color: #389e0d;
  background: #f6ffed;
}

.status-tag--muted {
  color: var(--color-muted);
  background: #f5f5f5;
}

.status-tag--default {
  color: var(--color-muted);
  background: #f5f5f5;
}
