.detail {
  padding: 20rpx 24rpx 60rpx;
}

.detail__status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 20rpx;
}

.detail__no {
  color: var(--color-muted);
  font-size: 24rpx;
}

.detail__card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.detail__step {
  display: flex;
  padding: 10rpx 0;
}

.detail__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin: 10rpx 20rpx 0 0;
  flex-shrink: 0;
}

.detail__step-label {
  font-size: 28rpx;
}

.detail__step-time {
  color: var(--color-muted);
  font-size: 24rpx;
}

.detail__row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.detail__row--total {
  border-top: 1rpx solid var(--color-border);
  margin-top: 8rpx;
  padding-top: 20rpx;
  font-weight: 600;
}

.detail__label {
  color: var(--color-muted);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.detail__muted {
  color: var(--color-muted);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.detail__tracking {
  display: flex;
  align-items: center;
}

.detail__copy {
  color: var(--color-primary);
  font-size: 24rpx;
  margin-left: 16rpx;
}

.detail__code {
  border-top: 1rpx solid var(--color-border);
  margin-top: 16rpx;
  padding-top: 20rpx;
  text-align: center;
}

.detail__code-label {
  color: var(--color-muted);
  font-size: 24rpx;
}

.detail__code-value {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: var(--color-primary);
  margin: 12rpx 0;
}

.detail__item {
  display: flex;
  padding: 16rpx 0;
}

.detail__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: var(--color-bg);
  flex-shrink: 0;
}

.detail__item-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.detail__item-unit {
  color: var(--color-muted);
  font-size: 24rpx;
}

.detail__item-row {
  display: flex;
  justify-content: space-between;
}

.detail__price {
  color: var(--color-price);
}

.detail__count {
  color: var(--color-muted);
}

.detail__pay {
  color: var(--color-price);
}

.detail__receiver {
  text-align: right;
}

.detail__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}

.detail__btn {
  border: 1rpx solid #dddddd;
  border-radius: 36rpx;
  padding: 0 36rpx;
  line-height: 68rpx;
  font-size: 28rpx;
}

.detail__btn--primary {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.detail__loading {
  text-align: center;
  color: var(--color-muted);
  padding: 60rpx 0;
}
