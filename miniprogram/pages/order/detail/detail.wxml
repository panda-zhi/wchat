<view class="detail">
  <empty wx:if="{{notFound}}" text="订单不存在或无权查看" button-text="返回订单列表" bind:action="goList" />

  <block wx:elif="{{order}}">
    <view class="detail__status">
      <status-tag status="{{order.status}}" delivery-type="{{order.deliveryType}}" />
      <text class="detail__no">订单号 {{order.orderNo}}</text>
    </view>

    <view class="detail__card">
      <view wx:for="{{timeline}}" wx:key="label" class="detail__step">
        <view class="detail__dot"></view>
        <view class="detail__step-body">
          <view class="detail__step-label">{{item.label}}</view>
          <view class="detail__step-time">{{item.time}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{order.deliveryType === 'express' && order.express && order.express.trackingNo}}" class="detail__card">
      <view class="detail__row">
        <text class="detail__label">快递公司</text>
        <text>{{order.express.company}}</text>
      </view>
      <view class="detail__row">
        <text class="detail__label">运单号</text>
        <view class="detail__tracking">
          <text>{{order.express.trackingNo}}</text>
          <text class="detail__copy" bindtap="onCopyTracking">复制</text>
        </view>
      </view>
    </view>

    <view wx:if="{{order.deliveryType === 'pickup' && order.pickup}}" class="detail__card">
      <view class="detail__row">
        <text class="detail__label">自提门店</text>
        <text>{{order.pickup.name}}</text>
      </view>
      <view class="detail__row">
        <text class="detail__label">门店地址</text>
        <text>{{order.pickup.address}}</text>
      </view>
      <view class="detail__row">
        <text class="detail__label">联系电话</text>
        <text>{{order.pickup.phone}}</text>
      </view>
      <view wx:if="{{order.pickup.code}}" class="detail__code">
        <view class="detail__code-label">自提码（到店出示）</view>
        <view class="detail__code-value" bindtap="onCopyPickupCode">{{order.pickup.code}}</view>
        <view class="detail__copy" bindtap="onCopyPickupCode">复制自提码</view>
      </view>
    </view>

    <view class="detail__card">
      <view wx:for="{{items}}" wx:key="goodsId" class="detail__item">
        <image class="detail__img" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="detail__item-body">
          <view class="detail__item-title">{{item.title}}</view>
          <view class="detail__item-unit">{{item.unit}}</view>
          <view class="detail__item-row">
            <text class="detail__price">¥{{item.priceText}}</text>
            <text class="detail__count">×{{item.count}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="detail__card">
      <view wx:if="{{order.deliveryType === 'express' && order.receiver}}" class="detail__row">
        <text class="detail__label">收货信息</text>
        <view class="detail__receiver">
          <view>{{order.receiver.name}} {{order.receiver.phone}}</view>
          <view class="detail__muted">{{order.receiver.region}} {{order.receiver.detail}}</view>
        </view>
      </view>
      <view wx:if="{{order.remark}}" class="detail__row">
        <text class="detail__label">备注</text>
        <text>{{order.remark}}</text>
      </view>
    </view>

    <view class="detail__card">
      <view class="detail__row">
        <text class="detail__label">商品合计</text>
        <text>¥{{order.goodsAmountText}}</text>
      </view>
      <view class="detail__row">
        <text class="detail__label">运费</text>
        <text>¥{{order.freightAmountText}}</text>
      </view>
      <view class="detail__row detail__row--total">
        <text>实付</text>
        <text class="detail__pay">¥{{order.payAmountText}}</text>
      </view>
    </view>

    <view class="detail__actions">
      <block wx:if="{{order.status === 'pending_pay'}}">
        <view class="detail__btn" bindtap="onCancel">取消订单</view>
        <view class="detail__btn detail__btn--primary" bindtap="onPay">去支付</view>
      </block>
      <block wx:elif="{{order.status === 'shipped'}}">
        <view class="detail__btn detail__btn--primary" bindtap="onConfirm">确认收货</view>
      </block>
    </view>
  </block>

  <view wx:if="{{loading}}" class="detail__loading">加载中…</view>
</view>
