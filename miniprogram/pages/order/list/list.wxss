.orders {
  padding-bottom: 40rpx;
}

.orders__tabs {
  display: flex;
  white-space: nowrap;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.orders__tab {
  display: inline-block;
  padding: 0 24rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}

.orders__tab--on {
  color: var(--color-primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--color-primary);
}

.orders__list {
  padding: 20rpx 24rpx 0;
}

.orders__card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.orders__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.orders__no {
  color: var(--color-muted);
  font-size: 24rpx;
}

.orders__body {
  display: flex;
  padding: 20rpx 0;
}

.orders__img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: var(--color-bg);
  flex-shrink: 0;
}

.orders__info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.orders__title {
  font-size: 28rpx;
  line-height: 1.4;
}

.orders__time {
  color: var(--color-muted);
  font-size: 24rpx;
  margin-top: 12rpx;
}

.orders__amount {
  text-align: right;
  flex-shrink: 0;
}

.orders__count {
  display: block;
  color: var(--color-muted);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.orders__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  border-top: 1rpx solid var(--color-border);
  padding-top: 16rpx;
}

.orders__btn {
  border: 1rpx solid #dddddd;
  color: var(--color-text);
  border-radius: 32rpx;
  padding: 0 28rpx;
  line-height: 60rpx;
  font-size: 26rpx;
}

.orders__btn--primary {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.orders__tip {
  text-align: center;
  color: var(--color-muted);
  font-size: 24rpx;
  padding: 20rpx 0;
}
