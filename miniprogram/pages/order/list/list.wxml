<view class="orders">
  <scroll-view class="orders__tabs" scroll-x="true" enable-flex="true">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="orders__tab {{tab === item.key ? 'orders__tab--on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSwitchTab"
    >{{item.label}}</view>
  </scroll-view>

  <empty wx:if="{{!loading && list.length === 0}}" text="暂无订单" />

  <view class="orders__list">
    <view wx:for="{{list}}" wx:key="_id" class="orders__card" data-id="{{item._id}}" bindtap="goDetail">
      <view class="orders__head">
        <text class="orders__no">订单号 {{item.shortNo}}</text>
        <status-tag status="{{item.status}}" delivery-type="{{item.deliveryType}}" />
      </view>

      <view class="orders__body">
        <image class="orders__img" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="orders__info">
          <view class="orders__title">{{item.titleText}}</view>
          <view class="orders__time">{{item.createdText}}</view>
        </view>
        <view class="orders__amount">
          <price value="{{item.payAmount}}" />
          <text class="orders__count">共 {{item.totalCount}} 件</text>
        </view>
      </view>

      <view class="orders__actions">
        <block wx:if="{{item.status === 'pending_pay'}}">
          <view class="orders__btn" data-id="{{item._id}}" catchtap="onCancel">取消订单</view>
          <view class="orders__btn orders__btn--primary" data-id="{{item._id}}" catchtap="onPay">去支付</view>
        </block>
        <block wx:elif="{{item.status === 'shipped'}}">
          <view class="orders__btn orders__btn--primary" data-id="{{item._id}}" catchtap="onConfirm">确认收货</view>
        </block>
        <block wx:elif="{{item.status === 'completed' || item.status === 'cancelled'}}">
          <view class="orders__btn" data-id="{{item._id}}" catchtap="onHide">删除</view>
        </block>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="orders__tip">加载中…</view>
  <view wx:elif="{{finished && list.length > 0}}" class="orders__tip">没有更多了</view>
</view>
