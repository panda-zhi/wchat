.aedit {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
}

.aedit__group {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx 20rpx;
  margin-bottom: 24rpx;
}

.aedit__row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.aedit__row:last-child {
  border-bottom: none;
}

.aedit__label {
  width: 180rpx;
  font-size: 28rpx;
  color: var(--color-text);
  flex-shrink: 0;
}

.aedit__label--block {
  width: auto;
  padding: 20rpx 0 12rpx;
}

.aedit__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
}

.aedit__picker {
  flex: 1;
}

.aedit__picker-value {
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
}

.aedit__images {
  display: flex;
  flex-wrap: wrap;
}

.aedit__image-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 16rpx 16rpx 0;
}

.aedit__image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.aedit__image-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}

.aedit__cover-tag {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 2rpx 10rpx;
  border-radius: 0 8rpx 0 12rpx;
  background: rgba(255, 122, 69, 0.9);
  color: #fff;
  font-size: 20rpx;
}

.aedit__upload {
  width: 180rpx;
  height: 180rpx;
  line-height: 176rpx;
  text-align: center;
  border: 1rpx dashed #ccc;
  border-radius: 12rpx;
  color: var(--color-muted);
  font-size: 48rpx;
}

.aedit__hint {
  font-size: 22rpx;
  color: var(--color-muted);
}

.aedit__textarea {
  width: 100%;
  height: 180rpx;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
  padding: 12rpx 0;
}

.aedit__submit {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
}

.aedit__submit--disabled {
  opacity: 0.6;
}
