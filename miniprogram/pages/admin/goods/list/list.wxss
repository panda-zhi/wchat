.agoods {
  min-height: 100vh;
  padding: 24rpx;
}

.agoods__bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.agoods__add {
  padding: 14rpx 28rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.agoods__card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.agoods__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.agoods__info {
  flex: 1;
  min-width: 0;
}

.agoods__title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agoods__meta {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.agoods__price {
  color: var(--color-price);
  font-size: 30rpx;
  font-weight: bold;
}

.agoods__stock {
  margin-right: 20rpx;
}

.agoods__stockops {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.agoods__step {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  color: var(--color-text);
}

.agoods__stocknum {
  min-width: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text);
  text-decoration: underline dotted;
}

.agoods__onoff {
  margin-left: auto;
  margin-right: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.agoods__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.agoods__btn {
  margin-left: 16rpx;
  padding: 10rpx 28rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-text);
}

.agoods__btn--primary {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.agoods__tip {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--color-muted);
}
