.verify {
  min-height: 100vh;
  padding: 24rpx;
}

.verify__card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.verify__label {
  font-size: 26rpx;
  color: var(--color-muted);
}

.verify__code {
  height: 140rpx;
  margin-top: 16rpx;
  font-size: 72rpx;
  letter-spacing: 16rpx;
  text-align: center;
  color: var(--color-text);
}

.verify__scan {
  display: inline-block;
  margin-top: 12rpx;
  padding: 12rpx 32rpx;
  border: 1rpx solid var(--color-primary);
  border-radius: 999rpx;
  color: var(--color-primary);
  font-size: 26rpx;
}

.verify__result {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
}

.verify__result--ok {
  background: #e8f8ec;
  color: #1a9c46;
}

.verify__result--error {
  background: #fdecec;
  color: var(--color-price);
}

.verify__submit {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
}

.verify__submit--disabled {
  opacity: 0.6;
}

.verify__again {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-primary);
}
