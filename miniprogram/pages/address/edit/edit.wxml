<view class="form">
  <view class="form__row">
    <text class="form__label">收货人</text>
    <input class="form__input" placeholder="请填写姓名" maxlength="20" value="{{name}}" data-field="name" bindinput="onInput" />
  </view>

  <view class="form__row">
    <text class="form__label">手机号</text>
    <input class="form__input" placeholder="请填写手机号" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="onInput" />
  </view>

  <view class="form__row">
    <text class="form__label">所在地区</text>
    <picker mode="region" value="{{region}}" bindchange="onRegionChange">
      <view class="form__input {{region.length === 3 ? '' : 'form__placeholder'}}">
        {{region.length === 3 ? region[0] + ' ' + region[1] + ' ' + region[2] : '请选择省市区'}}
      </view>
    </picker>
  </view>

  <view class="form__row form__row--column">
    <text class="form__label">详细地址</text>
    <textarea class="form__textarea" placeholder="街道、门牌号等" maxlength="100" value="{{detail}}" data-field="detail" bindinput="onInput" />
  </view>

  <view class="form__row form__row--between">
    <text class="form__label">设为默认地址</text>
    <switch checked="{{isDefault}}" color="#FF7A45" bindchange="onDefaultChange" />
  </view>

  <view class="form__footer">
    <button class="btn-primary" disabled="{{saving}}" bindtap="onSave">保存</button>
  </view>
</view>
