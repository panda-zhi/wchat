.mine {
  min-height: 100vh;
  padding: 24rpx;
}

.mine__card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
}

.mine__title {
  padding: 20rpx 0 12rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--color-text);
}

.mine__entries {
  display: flex;
}

.mine__entry {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--color-text);
}

.mine__entry--single {
  justify-content: space-between;
  border-top: 1rpx solid #f0f0f0;
}

.mine__entries .mine__entry + .mine__entry {
  border-left: 1rpx solid #f0f0f0;
}

.mine__entry-arrow {
  color: var(--color-muted);
}
